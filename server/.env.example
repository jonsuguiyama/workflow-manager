# Postgres connection (used if DATABASE_URL is not set - see db/database.js)
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

# Alternative to the DB_* vars above: a single connection string (what
# managed Postgres providers like Neon/Render typically give you). Takes
# priority over DB_* if set, and enables SSL automatically.
# DATABASE_URL=

PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# The deployed frontend's origin, for CORS. Leave unset locally - falls
# back to the Angular dev server (http://localhost:4200). Must be set
# explicitly in any deployed environment, e.g. https://your-app.vercel.app
CORS_ORIGIN=
